prefix=/ucrt64
# This file provides configuration information for OpenSSL
prefix=${prefix}
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: OpenSSL-libssl
Description: Secure Sockets Layer and cryptography libraries
Version: 4.1.0
Requires.private: libcrypto
Libs: -L${libdir} -lssl
Cflags: -I${includedir}
